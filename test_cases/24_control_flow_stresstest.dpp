// ==========================================
// NESTED LOOPS
// ==========================================

var i = 0;

while (i < 3)
{
    var j = 0;

    while (j < 3)
    {
        println(i * 10 + j);
        j += 1;
    }

    i += 1;
}

println();

// ==========================================
// BREAK
// ==========================================

var count = 0;

while (True)
{
    count += 1;

    if (count == 5)
        break;
}

println(count); // 5


// ==========================================
// CONTINUE
// ==========================================

var number = 0;

while (number < 10)
{
    number += 1;

    if (number % 2 == 0)
        continue;

    println(number); // 1, 3, 5, 7, 9
}

println();

// ==========================================
// NESTED FOR LOOPS
// ==========================================

for (var x = 1; x <= 3; x += 1)
{
    for (var y = 1; y <= 3; y += 1)
    {
        println(x * y);
    }
}

println();

// ==========================================
// BREAK INSIDE NESTED LOOPS
// ==========================================

for (var x = 0; x < 3; x += 1)
{
    for (var y = 0; y < 5; y += 1)
    {
        if (y == 2)
            break;

        println(x * 10 + y);
    }
}

println();