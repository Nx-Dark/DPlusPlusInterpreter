// ==========================================
// SQRT
// ==========================================

println(sqrt(0));       // 0
println(sqrt(1));       // 1
println(sqrt(4));       // 2
println(sqrt(9));       // 3
println(sqrt(2));       // Approximately 1.4142

// ==========================================
// POW
// ==========================================

println(pow(2, 3));     // 8
println(pow(5, 2));     // 25
println(pow(2, 0));     // 1
println(pow(2, -2));    // 0.25
println(pow(9, 0.5));   // 3

// ==========================================
// MAX
// ==========================================

println(max(1, 5));       // 5
println(max(-10, -2));    // -2
println(max(3.5, 3.8));   // 3.8

// ==========================================
// MIN
// ==========================================

println(min(1, 5));       // 1
println(min(-10, -2));    // -10
println(min(3.5, 3.8));   // 3.5

// ==========================================
// NESTED NATIVE CALLS
// ==========================================

println(sqrt(pow(3, 2)));       // 3
println(max(sqrt(16), pow(2, 3))); // 8
println(min(max(1, 10), 5));    // 5

// ==========================================
// NATIVE FUNCTIONS WITH VARIABLES
// ==========================================

var x = 25;
var y = 4;

println(sqrt(x));       // 5
println(pow(x, y));     // 390625
println(max(x, y));     // 25
println(min(x, y));     // 4